#!/bin/bash
# Single-orbital l_ec self-convergence sweep at the cRPA slab permittivity (ε = 2.4).
# Produces figs/lec_single_conv_eps2.4.tsv, which is panel (c) of the ε=2.4 Figure 9.
#
# WHY THIS RUN EXISTS. The only l_ec sweep in the repo is at ε = 10 (lec_single_conv_v2.tsv).
# Plotting it beside ε = 2.4 panels describes a different dielectric configuration, so
# scripts/plot_fig_63.jl emits a warning when the two disagree. This run removes that mismatch.
#
# Cheap by construction: ONE orbital (neighbor_cutoff = 0, on-site only), five refinement levels.
# The ε = 10 sweep solved in 31 / 37 / 69 / 137 / 252 s across levels 1–5 (≈9 min total), plus
# per-level prepare. The walltime below is generous because level 5 carries ~5.6M interface
# unknowns and its prepare dominates.
#
# Runs IN-PROCESS on one node (no SlurmManager workers), so a single exclusive node is enough.
# TKM3D_FINUFFT_NTHREADS is capped deliberately: an uncapped FINUFFT plan on a 96-thread node
# cripples the TKM3D evaluator (see the finufft-nthreads-cap work). Do not remove it.
#
# The campaign TOMLs (campaigns/lec_single_l{1..5}_eps2.4.toml) are regenerated by the script on
# each run, so they need not exist beforehand.
#
# SUBMIT (you — org policy bars the assistant from running sbatch):
#   cd /mnt/home/xgao1/work/four_index_integral_solver/codes/article/sec53_lattice
#   sbatch jobscripts/run_lec_conv_eps2.4.sbatch
# Pass a subset of levels as arguments if resuming, e.g. `... run_lec_conv_eps2.4.sbatch 4 5`
# (the script merges new rows into any existing TSV, keyed by level).
#   sbatch --export=ALL,RERUN_TAG=_eps2.4_mo64 jobscripts/run_lec_conv_eps2.4.sbatch 1 2 3 4 5 6 7
# is the max_order = 64 rerun: fresh roots, fresh TSV, the ε=2.4 max_order=8 sweep left intact
# beside it for comparison.
#
#SBATCH --partition=ccm
#SBATCH --constraint=genoa
#SBATCH --exclusive
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=96
#SBATCH --time=12:00:00
#SBATCH --job-name=fi_lec_eps24
#SBATCH --output=logs/lec_conv_eps2.4_%j.out

set -euo pipefail
LEVELS=${@:-1 2 3 4 5}

export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
# OpenBLAS gets ONE thread. The 2.95x-at-64-threads figure this once cited comes from the
# Sec. 5.2 benchmark -- a SINGLE process at -t 64/96, where an equally sized BLAS pool
# oversubscribes the node against FMM3D and FINUFFT. It does NOT describe this pipeline: job
# 7012357 timed the campaign's own evaluation at 8 and 96 Julia threads crossed with OPENBLAS
# 1 and 96, and all four cells landed within 3% (231.9-239.6 s). Keeping 1 because it is
# right for the single-process case and measured harmless here.
export OPENBLAS_NUM_THREADS=1
export TKM3D_FINUFFT_NTHREADS=16              # cap: see header
# RERUN_TAG names the campaigns, their ceph roots AND the output TSV -- and it MUST change for
# any rerun that changes the solver, because solve_batch() skips a batch whose result file
# already exists. Reusing a tag after an accuracy change silently re-emits the OLD numbers.
export RERUN_TAG=${RERUN_TAG:-_eps2.4}        # e.g. _eps2.4_mo64 for the max_order = 64 rerun
export RERUN_BASE=lattice_10x10_het3x_eps2.4  # inherit the ε = 2.4 dielectric boxes
JULIA=/mnt/home/xgao1/.juliaup/bin/julia      # juliaup launcher (never `module load julia`)

cd /mnt/home/xgao1/work/four_index_integral_solver/codes/article/sec53_lattice
mkdir -p logs

echo "=== lec sweep (eps=2.4) levels: $LEVELS   $(date) ==="
$JULIA --project -t 8 scripts/lec_conv_single.jl $LEVELS
echo "=== SWEEP DONE  $(date)  ->  figs/lec_single_conv${RERUN_TAG}.tsv ==="
